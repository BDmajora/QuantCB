cat <<EOF > .gitignore
# Environments
venv/
env/
.env

# Python Bytecode and Cache
__pycache__/
models/__pycache__/
src/__pycache__/
tests/__pycache__/
*.pyc
*.pyo
*.pyd

# OS Metadata
.DS_Store
Thumbs.db

# AI Training Data & Brains
*.pth
*.json
/modelOutput/

# Analytics & Reports
*.png

# Project Specifics
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Rust Build Artifacts
/quantcd_rust/target/
EOF